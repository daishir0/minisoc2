# build artifacts (match anywhere)
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# build outputs (root only)
/agent/dist/
/server/data/
/server/test-results/
/server/playwright-report/

# secrets (never commit, match anywhere)
.env
.env*.local
*.pem
*.key
.DS_Store

# host-specific working dirs/files (root only — must not match app routes like src/app/.../logs)
/infrastructure/
/logs/
/outputs/
/memo.md
/CLAUDE.md
/CLAUDE.local.md
/.claude/
